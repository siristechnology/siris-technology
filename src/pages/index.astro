---
import SiteLayout from '../layouts/SiteLayout.astro'
import AppPreview from '../components/AppPreview.astro'
---

<SiteLayout
  title="Siris Technology — Nepal Today for iPhone"
  description="Meet Nepal Today, a private and personalized news, podcast, and live FM app coming soon to iPhone."
>
  <section class="hero section">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <a class="announcement" href="#features">
          <img src="/assets/nepal-today-icon.png" width="30" height="30" alt="" />
          <span>Nepal Today for iPhone</span>
          <strong>Coming soon</strong>
          <span aria-hidden="true">→</span>
        </a>

        <p class="kicker">Your connection to Nepal</p>
        <h1>Stay connected<br /><em>to Nepal.</em></h1>
        <p class="hero-lede">
          Nepal Today brings personalized news, podcasts, and live FM together in one native iPhone app—without requiring an account.
        </p>

        <div class="hero-actions">
          <span class="app-store-button" aria-label="Coming soon to the App Store">
            <span class="apple-mark" aria-hidden="true">●</span>
            <span><small>COMING SOON TO THE</small><strong>App Store</strong></span>
          </span>
          <a class="text-link" href="#features">Explore the app <span aria-hidden="true">↓</span></a>
        </div>

        <div class="trust-row" aria-label="Nepal Today highlights">
          <span><b>iOS</b> Native</span>
          <span><b>No account</b> Required</span>
          <span><b>Every story</b> Linked to sources</span>
        </div>
      </div>

      <AppPreview />
    </div>
  </section>

  <section class="features section" id="features">
    <div class="shell">
      <div class="section-heading">
        <p class="kicker">A closer look</p>
        <h2>One app. Three ways to stay connected.</h2>
        <p>
          Browse real Nepal Today screens for news, podcasts, and live Nepal FM.
        </p>
      </div>

      <div class="product-slider" data-product-slider>
        <div class="product-slide-tabs" role="tablist" aria-label="Nepal Today features">
          <button id="feature-tab-news" type="button" role="tab" aria-selected="true" aria-controls="feature-slide-news" data-slide-tab>
            <span>01</span><strong>News</strong>
          </button>
          <button id="feature-tab-podcasts" type="button" role="tab" aria-selected="false" aria-controls="feature-slide-podcasts" tabindex="-1" data-slide-tab>
            <span>02</span><strong>Podcasts</strong>
          </button>
          <button id="feature-tab-fm" type="button" role="tab" aria-selected="false" aria-controls="feature-slide-fm" tabindex="-1" data-slide-tab>
            <span>03</span><strong>Live FM</strong>
          </button>
        </div>

        <div class="product-slides">
          <article id="feature-slide-news" class="product-slide" role="tabpanel" aria-labelledby="feature-tab-news" data-slide-panel>
            <div class="slide-copy">
              <p class="eyebrow">PERSONALIZED NEWS + AI CONTEXT</p>
              <h3>News shaped for you, with clearer context.</h3>
              <p>Your interests shape the feed. When publishers cover the same story, AI creates one shared overview from their reports—not from your private activity. Every original source remains linked.</p>
              <a href="/privacy/">How we protect your privacy <span aria-hidden="true">→</span></a>
            </div>
            <div class="slide-stage slide-stage--news">
              <div class="news-screen-pair">
                <div class="app-screen-frame">
                  <img src="/assets/nepal-today-feed-screen.png" width="493" height="1069" alt="Nepal Today personalized Home feed on iPhone" loading="lazy" />
                </div>
                <div class="app-screen-frame">
                  <img src="/assets/nepal-today-story-screen.png" width="493" height="1069" alt="A Nepal Today article detail screen on iPhone" loading="lazy" />
                </div>
              </div>
              <div class="slide-annotation slide-annotation--news" aria-hidden="true">
                <strong>AI summarizes reporting—not you</strong>
                <span>Every publisher stays linked</span>
              </div>
            </div>
          </article>

          <article id="feature-slide-podcasts" class="product-slide" role="tabpanel" aria-labelledby="feature-tab-podcasts" data-slide-panel hidden>
            <div class="slide-copy">
              <p class="eyebrow">PODCASTS</p>
              <h3>Follow programs. Listen anywhere.</h3>
              <p>Keep up with favorite programs, find recent episodes, and download them for offline listening.</p>
            </div>
            <div class="slide-stage slide-stage--podcasts">
              <div class="app-screen-frame">
                <img src="/assets/nepal-today-podcasts-screen.png" width="493" height="1069" alt="Nepal Today podcast programs and episodes on iPhone" loading="lazy" />
              </div>
              <div class="slide-annotation slide-annotation--podcasts" aria-hidden="true">
                <strong>Your programs, ready to go</strong>
                <span>Follow and download episodes</span>
              </div>
            </div>
          </article>

          <article id="feature-slide-fm" class="product-slide" role="tabpanel" aria-labelledby="feature-tab-fm" data-slide-panel hidden>
            <div class="slide-copy">
              <p class="eyebrow">LIVE NEPAL FM</p>
              <h3>Live radio, wherever you are.</h3>
              <p>Favorite verified stations and move through publisher-hosted live streams with one persistent player.</p>
            </div>
            <div class="slide-stage slide-stage--radio">
              <div class="app-screen-frame">
                <img src="/assets/nepal-today-radio-screen.png" width="493" height="1069" alt="Nepal Today live FM player on iPhone" loading="lazy" />
              </div>
              <div class="slide-annotation slide-annotation--radio" aria-hidden="true">
                <strong>Live, verified stations</strong>
                <span>Publisher-hosted streams</span>
              </div>
            </div>
          </article>
        </div>
      </div>

      <script is:inline>
        for (const slider of document.querySelectorAll('[data-product-slider]')) {
          const tabs = Array.from(slider.querySelectorAll('[data-slide-tab]'))
          const panels = Array.from(slider.querySelectorAll('[data-slide-panel]'))

          const selectSlide = (index, moveFocus = false) => {
            tabs.forEach((tab, tabIndex) => {
              const selected = tabIndex === index
              tab.setAttribute('aria-selected', String(selected))
              tab.tabIndex = selected ? 0 : -1
              panels[tabIndex].hidden = !selected
            })
            if (moveFocus) tabs[index].focus()
          }

          tabs.forEach((tab, index) => {
            tab.addEventListener('click', () => selectSlide(index))
            tab.addEventListener('keydown', (event) => {
              if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return
              event.preventDefault()
              const direction = event.key === 'ArrowRight' ? 1 : -1
              selectSlide((index + direction + tabs.length) % tabs.length, true)
            })
          })
        }
      </script>

      <div class="feature-cta">
        <div>
          <img src="/assets/nepal-today-icon.png" width="72" height="72" alt="Nepal Today app icon" />
          <div>
            <p class="kicker">Built by Siris Technology</p>
            <h2>Made for iPhone. Coming soon.</h2>
          </div>
        </div>
        <a class="button" href="/contact/">Send us feedback <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</SiteLayout>
