---
import SiteLayout from '../layouts/SiteLayout.astro'
---

<SiteLayout
  title="Contact Us — Siris Technology"
  description="Contact Siris Technology with feedback, support questions, or privacy requests about Nepal Today."
>
  <section class="contact-page section">
    <div class="shell">
      <header class="contact-heading">
        <p class="kicker">Contact us</p>
        <h1>Send us a message.</h1>
        <p>Share feedback about Nepal Today, ask a support question, or send a privacy request.</p>
        <p>Email works too: <a href="mailto:info@siristechnology.com">info@siristechnology.com</a></p>
      </header>

      <form
        class="contact-form"
        name="contact"
        method="POST"
        action="/thanks/"
        data-netlify="true"
        netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden-field" aria-hidden="true">
          <label>Do not fill this out if you are human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>

        <div class="field-row">
          <label>
            <span>Name</span>
            <input type="text" name="name" autocomplete="name" maxlength="120" required />
          </label>
          <label>
            <span>Email</span>
            <input type="email" name="email" autocomplete="email" maxlength="254" required />
          </label>
        </div>

        <label>
          <span>Subject</span>
          <input type="text" name="subject" maxlength="160" required />
        </label>

        <label>
          <span>Message</span>
          <textarea name="message" rows="7" maxlength="5000" required></textarea>
        </label>

        <div class="form-footer">
          <p>By submitting, you agree that we may use these details to respond. See our <a href="/privacy/">Privacy Policy</a>.</p>
          <button type="submit">Send message <span aria-hidden="true">→</span></button>
        </div>
      </form>

      <p class="contact-safety-note">Please do not include passwords, authentication tokens, or other sensitive information.</p>
    </div>
  </section>
</SiteLayout>
