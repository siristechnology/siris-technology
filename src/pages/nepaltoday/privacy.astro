<SiteLayout
  title="NepalToday Privacy Policy — Siris Technology"
  description="How Siris Technology collects, uses, retains, and protects information in the NepalToday iOS app and website."
>
  <article class="policy policy-page section">
    <div class="shell">
      <header class="policy-heading">
        <p class="kicker">NepalToday for iOS</p>
        <h1>Privacy Policy</h1>
        <p>NepalToday does not require an account, use advertising identifiers, or track you across apps, websites, or devices.</p>
        <p class="policy-effective"><strong>Effective:</strong> August 18, 2026</p>
      </header>

      <div class="policy-layout">
      <aside class="policy-nav" aria-label="Privacy policy sections">
        <p class="eyebrow">ON THIS PAGE</p>
        <a href="#overview">Overview</a>
        <a href="#information">Information we handle</a>
        <a href="#use">How we use it</a>
