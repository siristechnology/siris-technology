---
import SiteLayout from '../layouts/SiteLayout.astro'
---

<SiteLayout
  title="Message sent — Siris Technology"
  description="Your message has been sent to Siris Technology."
  noindex={true}
>
  <section class="result-page section">
    <div class="shell result-card">
      <span class="result-icon" aria-hidden="true">✓</span>
      <p class="kicker">Message sent</p>
      <h1>Thank you.</h1>
      <p>Your message is on its way to Siris Technology. We’ll respond as soon as we can.</p>
      <a class="button" href="/">Back to home <span aria-hidden="true">→</span></a>
    </div>
  </section>
</SiteLayout>
